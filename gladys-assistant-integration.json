{
  "manifest_version": 1,
  "type": "device",
  "name": "Hyundai / Kia",
  "description": {
    "en": "Hyundai Bluelink and Kia Connect cars (Europe): battery, charging, climate, locks.",
    "fr": "Voitures Hyundai Bluelink et Kia Connect (Europe) : batterie, charge, clim, verrouillage."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-hyundai-kia:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-hyundai-kia/main/cover.png",
  "categories": ["energy"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Before you start",
        "fr": "Avant de commencer"
      },
      "description": {
        "en": "This integration signs in to your Hyundai Bluelink or Kia Connect account (Europe), like the official app. Use the account of the app where your car appears. Reading the state the car last sent never wakes it; commands and forced refreshes do. Remote commands (locks, climate, charging) need the 4-digit PIN of the account.",
        "fr": "Cette intégration se connecte à votre compte Hyundai Bluelink ou Kia Connect (Europe), comme l'application officielle. Utilisez le compte de l'application où apparaît votre voiture. Lire l'état que la voiture a envoyé en dernier ne la réveille jamais ; les commandes et les relevés forcés, si. Les commandes à distance (verrouillage, climatisation, charge) demandent le code PIN à 4 chiffres du compte."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-hyundai-kia/blob/main/docs/en.md",
          "label": {
            "en": "Documentation",
            "fr": "Documentation"
          }
        }
      ]
    },
    {
      "key": "brand",
      "type": "select",
      "label": {
        "en": "Brand",
        "fr": "Marque"
      },
      "description": {
        "en": "Brand of the account (one integration per brand).",
        "fr": "Marque du compte (une intégration par marque)."
      },
      "required": false,
      "default": "hyundai",
      "options": [
        {
          "value": "hyundai",
          "label": {
            "en": "Hyundai (Bluelink)",
            "fr": "Hyundai (Bluelink)"
          }
        },
        {
          "value": "kia",
          "label": {
            "en": "Kia (Kia Connect)",
            "fr": "Kia (Kia Connect)"
          }
        }
      ]
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "E-mail address",
        "fr": "Adresse e-mail"
      },
      "description": {
        "en": "The e-mail address of your Bluelink or Kia Connect account.",
        "fr": "L'adresse e-mail de votre compte Bluelink ou Kia Connect."
      },
      "placeholder": {
        "en": "name@example.com",
        "fr": "nom@exemple.fr"
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe"
      },
      "description": {
        "en": "The password of the account. If the sign-in is refused although the password is right, paste a refresh token here instead (see the documentation).",
        "fr": "Le mot de passe du compte. Si la connexion est refusée alors que le mot de passe est juste, collez ici un jeton de rafraîchissement à la place (voir la documentation)."
      },
      "required": true
    },
    {
      "key": "pin",
      "type": "secret",
      "label": {
        "en": "PIN (4 digits)",
        "fr": "Code PIN (4 chiffres)"
      },
      "description": {
        "en": "The 4-digit PIN of the account, the one the app asks for. Needed for remote commands (locks, climate, charging).",
        "fr": "Le code PIN à 4 chiffres du compte, celui que demande l'application. Nécessaire pour les commandes à distance (verrouillage, climatisation, charge)."
      },
      "required": false
    },
    {
      "key": "account_language",
      "type": "select",
      "label": {
        "en": "Account language",
        "fr": "Langue du compte"
      },
      "description": {
        "en": "Language of your account, kept as is by the sign-in (the official app follows it).",
        "fr": "Langue de votre compte, conservée par la connexion (l'application officielle la suit)."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand"
          }
        },
        {
          "value": "it",
          "label": {
            "en": "Italian",
            "fr": "Italien"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol"
          }
        },
        {
          "value": "nl",
          "label": {
            "en": "Dutch",
            "fr": "Néerlandais"
          }
        },
        {
          "value": "pt",
          "label": {
            "en": "Portuguese",
            "fr": "Portugais"
          }
        },
        {
          "value": "sv",
          "label": {
            "en": "Swedish",
            "fr": "Suédois"
          }
        },
        {
          "value": "no",
          "label": {
            "en": "Norwegian",
            "fr": "Norvégien"
          }
        },
        {
          "value": "da",
          "label": {
            "en": "Danish",
            "fr": "Danois"
          }
        },
        {
          "value": "fi",
          "label": {
            "en": "Finnish",
            "fr": "Finnois"
          }
        },
        {
          "value": "pl",
          "label": {
            "en": "Polish",
            "fr": "Polonais"
          }
        },
        {
          "value": "cs",
          "label": {
            "en": "Czech",
            "fr": "Tchèque"
          }
        },
        {
          "value": "sk",
          "label": {
            "en": "Slovak",
            "fr": "Slovaque"
          }
        },
        {
          "value": "hu",
          "label": {
            "en": "Hungarian",
            "fr": "Hongrois"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Device names language",
        "fr": "Langue des noms d'appareils"
      },
      "description": {
        "en": "Language of the feature names given to new devices (Gladys keeps a name once the device is created).",
        "fr": "Langue des noms de fonctionnalités des nouveaux appareils (Gladys garde un nom une fois l'appareil créé)."
      },
      "required": false,
      "default": "en",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français"
          }
        }
      ]
    },
    {
      "key": "refresh_minutes",
      "type": "select",
      "label": {
        "en": "Refresh",
        "fr": "Relevé"
      },
      "description": {
        "en": "How often the state the car last sent to the cloud is read. Never wakes the car.",
        "fr": "Fréquence de lecture de l'état que la voiture a envoyé au cloud. Ne réveille jamais la voiture."
      },
      "required": false,
      "default": "30",
      "options": [
        {
          "value": "15",
          "label": {
            "en": "Every 15 minutes",
            "fr": "Toutes les 15 minutes"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "Every 30 minutes",
            "fr": "Toutes les 30 minutes"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "Every hour",
            "fr": "Toutes les heures"
          }
        }
      ]
    },
    {
      "key": "force_refresh_hours",
      "type": "select",
      "label": {
        "en": "Forced refresh",
        "fr": "Relevé forcé"
      },
      "description": {
        "en": "Wakes the car to read its current state, never between 10 pm and 6 am. It drains the 12 V battery and counts in a daily quota: keep it off unless needed.",
        "fr": "Réveille la voiture pour lire son état actuel, jamais entre 22 h et 6 h. Cela sollicite la batterie 12 V et compte dans un quota quotidien : laissez-le désactivé sauf besoin."
      },
      "required": false,
      "default": "0",
      "options": [
        {
          "value": "0",
          "label": {
            "en": "Never (on request only)",
            "fr": "Jamais (sur demande seulement)"
          }
        },
        {
          "value": "2",
          "label": {
            "en": "Every 2 hours",
            "fr": "Toutes les 2 heures"
          }
        },
        {
          "value": "4",
          "label": {
            "en": "Every 4 hours",
            "fr": "Toutes les 4 heures"
          }
        },
        {
          "value": "8",
          "label": {
            "en": "Every 8 hours",
            "fr": "Toutes les 8 heures"
          }
        },
        {
          "value": "12",
          "label": {
            "en": "Every 12 hours",
            "fr": "Toutes les 12 heures"
          }
        }
      ]
    },
    {
      "key": "climate_duration",
      "type": "select",
      "label": {
        "en": "Climate duration",
        "fr": "Durée de la climatisation"
      },
      "description": {
        "en": "How long the climate runs when started from Gladys.",
        "fr": "Durée de fonctionnement de la climatisation lancée depuis Gladys."
      },
      "required": false,
      "default": "10",
      "options": [
        {
          "value": "5",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "10 minutes",
            "fr": "10 minutes"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes"
          }
        },
        {
          "value": "20",
          "label": {
            "en": "20 minutes",
            "fr": "20 minutes"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 minutes",
            "fr": "30 minutes"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion"
      },
      "description": {
        "en": "Signs in and lists the vehicles of the account. No car is woken.",
        "fr": "Se connecte et liste les véhicules du compte. Aucune voiture n'est réveillée."
      },
      "timeout_seconds": 60
    }
  ],
  "scene_actions": [
    {
      "key": "refresh_vehicle",
      "label": {
        "en": "Refresh a Hyundai / Kia vehicle",
        "fr": "Actualiser un véhicule Hyundai / Kia"
      },
      "description": {
        "en": "Wakes the car and reads its current state, for the next actions of the scene.",
        "fr": "Réveille la voiture et lit son état actuel, pour les actions suivantes de la scène."
      },
      "timeout_seconds": 90,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Vehicle",
            "fr": "Véhicule"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "battery_level",
          "type": "number",
          "label": {
            "en": "Battery level (%)",
            "fr": "Niveau de batterie (%)"
          }
        },
        {
          "key": "range_km",
          "type": "number",
          "label": {
            "en": "Range (km)",
            "fr": "Autonomie (km)"
          }
        }
      ]
    },
    {
      "key": "start_climate",
      "label": {
        "en": "Start the climate of a Hyundai / Kia",
        "fr": "Lancer la clim d'une Hyundai / Kia"
      },
      "description": {
        "en": "Heats or cools the cabin at the chosen temperature, for the chosen duration.",
        "fr": "Chauffe ou rafraîchit l'habitacle à la température et pour la durée choisies."
      },
      "timeout_seconds": 120,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Vehicle",
            "fr": "Véhicule"
          },
          "required": true
        },
        {
          "key": "temperature",
          "type": "number",
          "label": {
            "en": "Temperature (°C)",
            "fr": "Température (°C)"
          },
          "description": {
            "en": "16 to 30 °C. Empty: the setpoint of the vehicle in Gladys.",
            "fr": "16 à 30 °C. Vide : la consigne du véhicule dans Gladys."
          },
          "placeholder": {
            "en": "e.g. 21",
            "fr": "ex. 21"
          },
          "required": false,
          "min": 16,
          "max": 30
        },
        {
          "key": "duration",
          "type": "number",
          "label": {
            "en": "Duration (minutes)",
            "fr": "Durée (minutes)"
          },
          "description": {
            "en": "1 to 30 minutes. Empty: the duration of the configuration.",
            "fr": "1 à 30 minutes. Vide : la durée de la configuration."
          },
          "placeholder": {
            "en": "e.g. 10",
            "fr": "ex. 10"
          },
          "required": false,
          "min": 1,
          "max": 30
        }
      ],
      "outputs": [
        {
          "key": "temperature",
          "type": "number",
          "label": {
            "en": "Temperature sent (°C)",
            "fr": "Température envoyée (°C)"
          }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "vehicle",
      "label": {
        "en": "Hyundai / Kia vehicle",
        "fr": "Véhicule Hyundai / Kia"
      },
      "description": {
        "en": "Battery, range, charging, climate and locks, with buttons to act on the car.",
        "fr": "Batterie, autonomie, charge, clim et verrous, avec des boutons pour agir sur la voiture."
      },
      "icon": "battery-charging",
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Vehicle",
            "fr": "Véhicule"
          },
          "required": true
        }
      ],
      "action_timeout_seconds": 120
    }
  ]
}
